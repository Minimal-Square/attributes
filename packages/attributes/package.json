{
  "name": "@minimalsquare/attributes",
  "version": "0.0.0",
  "description": "Minimal Attributes",
  "homepage": "https://minimal-ui.com/docs/attributes",
  "type": "module",
  "main": "dist/attributes.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development node ./bin/build.js",
    "build": "cross-env NODE_ENV=production node ./bin/build.js",
    "lint": "eslint ./src && prettier --check ./src",
    "lint:fix": "eslint ./src --fix && prettier --write ./src",
    "check": "tsc --noEmit",
    "test": "pnpm playwright test",
    "test:headed": "pnpm playwright test --headed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@minimalsquare/attributes-kbd": "workspace:*",
    "@minimalsquare/attributes-phoneinput": "workspace:*",
    "@minimalsquare/attributes-passwordvisibility": "workspace:*",
    "@minimalsquare/attributes-checkbox": "workspace:*",
    "@minimalsquare/attributes-formvalidation": "workspace:*",
    "@minimalsquare/attributes-utils": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.19.0",
    "tsx": "^4.16.2"
  }
}
